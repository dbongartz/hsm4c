{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc",
      "displayName": "GCC",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "displayName": "Clang",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "ci-gcc",
      "displayName": "CI: GCC, warnings as errors",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "ci-clang",
      "displayName": "CI: Clang, warnings as errors",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "GCC with AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "ci-gcc",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    },
    {
      "name": "minimal",
      "displayName": "GCC, all optional features off, smallest types",
      "inherits": "ci-gcc",
      "cacheVariables": {
        "HSM4C_BUILD_EXAMPLES": "OFF",
        "HSM4C_CONFIG_STATE_NAMES": "OFF",
        "HSM4C_CONFIG_RUN_FN": "OFF",
        "HSM4C_CONFIG_GUARDS": "OFF",
        "HSM4C_CONFIG_ACTIONS": "OFF",
        "HSM4C_CONFIG_VALIDATE": "OFF",
        "HSM4C_EVENT_QUEUE_SIZE": "1",
        "HSM4C_STATE_ID_TYPE": "uint8_t"
      }
    },
    {
      "name": "coverage",
      "displayName": "GCC with coverage instrumentation",
      "inherits": "gcc",
      "cacheVariables": {
        "HSM4C_BUILD_EXAMPLES": "OFF",
        "CMAKE_C_FLAGS": "--coverage",
        "CMAKE_CXX_FLAGS": "--coverage"
      }
    },
    {
      "name": "lint",
      "displayName": "Clang with compilation database for clang-tidy",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "docs",
      "displayName": "API documentation only",
      "inherits": "base",
      "cacheVariables": {
        "HSM4C_BUILD_DOCS": "ON",
        "HSM4C_BUILD_TESTS": "OFF",
        "HSM4C_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release build",
      "inherits": "ci-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc",
      "configurePreset": "gcc"
    },
    {
      "name": "clang",
      "configurePreset": "clang"
    },
    {
      "name": "ci-gcc",
      "configurePreset": "ci-gcc"
    },
    {
      "name": "ci-clang",
      "configurePreset": "ci-clang"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "minimal",
      "configurePreset": "minimal"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "lint",
      "configurePreset": "lint"
    },
    {
      "name": "docs",
      "configurePreset": "docs",
      "targets": [
        "hsm4c_docs"
      ]
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "gcc",
      "inherits": "base",
      "configurePreset": "gcc"
    },
    {
      "name": "clang",
      "inherits": "base",
      "configurePreset": "clang"
    },
    {
      "name": "ci-gcc",
      "inherits": "base",
      "configurePreset": "ci-gcc"
    },
    {
      "name": "ci-clang",
      "inherits": "base",
      "configurePreset": "ci-clang"
    },
    {
      "name": "sanitize",
      "inherits": "base",
      "configurePreset": "sanitize"
    },
    {
      "name": "minimal",
      "inherits": "base",
      "configurePreset": "minimal"
    },
    {
      "name": "coverage",
      "inherits": "base",
      "configurePreset": "coverage"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    }
  ],
  "workflowPresets": [
    {
      "name": "ci-gcc",
      "steps": [
        {
          "type": "configure",
          "name": "ci-gcc"
        },
        {
          "type": "build",
          "name": "ci-gcc"
        },
        {
          "type": "test",
          "name": "ci-gcc"
        }
      ]
    },
    {
      "name": "ci-clang",
      "steps": [
        {
          "type": "configure",
          "name": "ci-clang"
        },
        {
          "type": "build",
          "name": "ci-clang"
        },
        {
          "type": "test",
          "name": "ci-clang"
        }
      ]
    },
    {
      "name": "sanitize",
      "steps": [
        {
          "type": "configure",
          "name": "sanitize"
        },
        {
          "type": "build",
          "name": "sanitize"
        },
        {
          "type": "test",
          "name": "sanitize"
        }
      ]
    },
    {
      "name": "minimal",
      "steps": [
        {
          "type": "configure",
          "name": "minimal"
        },
        {
          "type": "build",
          "name": "minimal"
        },
        {
          "type": "test",
          "name": "minimal"
        }
      ]
    },
    {
      "name": "coverage",
      "steps": [
        {
          "type": "configure",
          "name": "coverage"
        },
        {
          "type": "build",
          "name": "coverage"
        },
        {
          "type": "test",
          "name": "coverage"
        }
      ]
    },
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    }
  ]
}
